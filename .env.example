# Canonical domain (used for canonical URLs, sitemap, schema, IndexNow)
NEXT_PUBLIC_SITE_URL=https://www.dholpurstones.com

# ── Lead delivery (set at least one, otherwise leads appear only in server logs) ──
# Email each enquiry via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=gargcorporationltd@gmail.com
LEAD_FROM_EMAIL=Dholpurstones Leads <leads@yourdomain.com>
# Or push each enquiry to a webhook (Google Sheets Apps Script, Zapier, Make, CRM)
LEAD_WEBHOOK_URL=

# Or send each enquiry to the owner's WhatsApp automatically (Meta WhatsApp Cloud API)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
LEAD_WHATSAPP_TO=919414945457
# Template name (needed because business-initiated messages outside the 24h window must use an approved template; body takes 1 text variable)
WHATSAPP_TEMPLATE_NAME=

# ── Search engines ──
# Bing Webmaster Tools verification code (the content value of msvalidate.01)
NEXT_PUBLIC_BING_VERIFICATION=
# Secret that protects POST /api/indexnow
INDEXNOW_SECRET=
